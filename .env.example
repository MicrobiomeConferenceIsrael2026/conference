# Copy to .env — or better, run `npm run init-secrets`, which fills in real
# random keys and an admin password for you.

NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
TRUST_PROXY=false

# 32 random bytes as hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=
SESSION_SECRET=

ADMIN_USER=admin
# node -e "console.log(require('bcryptjs').hashSync('your password', 12))"
ADMIN_PASSWORD_HASH=
# (alternative to the hash, less good)
ADMIN_PASSWORD=

# Leave SMTP_HOST empty to run without mail — confirmations then land in data/outbox/.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Microbiome 2026 <no-reply@example.ac.il>"
MAIL_BCC=
