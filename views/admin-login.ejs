<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Organiser login — <%= c.shortTitle %></title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/site.css">
</head>
<body class="login-page">
  <div class="login-card">
    <div class="login-card__head">
      <div class="eyebrow eyebrow-light">Restricted area</div>
      <h1>Organiser sign-in</h1>
    </div>
    <div class="login-card__body">
      <% if (error) { %>
        <div class="alert alert--error"><%= error %></div>
      <% } %>

      <form method="post" action="/admin/login" autocomplete="off">
        <input type="hidden" name="_csrf" value="<%= csrf %>">

        <div class="field">
          <label class="field__label" for="username">Username</label>
          <input type="text" id="username" name="username" required autofocus
                 autocomplete="username" spellcheck="false">
        </div>

        <div class="field">
          <label class="field__label" for="password">Password</label>
          <input type="password" id="password" name="password" required
                 autocomplete="current-password"
                 style="width:100%;font-family:var(--sans);font-size:15px;background:#fdfcf9;border:1px solid var(--line);border-radius:var(--radius);padding:11px 13px">
        </div>

        <button class="btn btn--navy btn--full" type="submit" style="margin-top:8px">Sign in</button>
      </form>

      <p class="login-foot">
        Registration data is encrypted at rest. Attempts are rate-limited and logged.<br>
        <a href="/" style="color:var(--muted)">← Back to the conference site</a>
      </p>
    </div>
  </div>
</body>
</html>
