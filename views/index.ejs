<%- include('partials/head', { pageTitle: undefined }) %>
<%- include('partials/header') %>

<main id="main">

  <!-- ================= HERO ================= -->
  <section class="hero">
    <div class="wrap">
     <div class="hero__inner">
      <div>
        <h1 class="hero__title"><%= c.title %></h1>
        <p class="hero__sub"><%= c.subtitle %></p>
        <div class="hero__meta">
          <div><span class="dot"></span><%= c.date %> · <%= c.timeRange %></div>
          <div><span class="dot"></span><%= c.venue %>, <%= c.venueCity %></div>
          <div><span class="dot"></span><%= c.fee %> to attend</div>
        </div>
        <div class="hero__actions">
          <a class="btn btn--navy" href="/register">Register</a>
          <a class="btn btn--ghost" href="#program">Program</a>
        </div>
        <p class="hero__note">Abstracts close <%= c.abstractDeadline %> · registration closes <%= c.registrationDeadline %></p>
      </div>
      <div class="hero__art">
        <img src="/img/hero-microbiome.jpg" alt="Fluorescence micrograph of a dense bacterial community">
      </div>
     </div>
    </div>
  </section>

  <!-- ================= FACTS ================= -->
  <section class="facts">
    <div class="wrap">
      <div class="facts__grid">
        <div class="facts__cell">
          <div class="facts__k">Date</div>
          <div class="facts__v"><%= c.date %><small><%= c.timeRange %></small></div>
        </div>
        <div class="facts__cell">
          <div class="facts__k">Venue</div>
          <div class="facts__v"><%= c.venue %><small><%= c.venueCity %></small></div>
        </div>
        <div class="facts__cell">
          <div class="facts__k">Registration</div>
          <div class="facts__v"><%= c.fee %><small>Closes <%= c.registrationDeadline %></small></div>
        </div>
        <div class="facts__cell">
          <div class="facts__k">Abstracts</div>
          <div class="facts__v">Open<small>Until <%= c.abstractDeadline %></small></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= ABOUT ================= -->
  <section class="section" id="about">
    <div class="wrap split">
      <div>
        <p style="font-size:1.15rem;line-height:1.55;max-width:56ch;margin:0"><%= c.about %></p>
      </div>

      <aside>
        <div class="card card--tint">
          <div class="card__title">Who should come</div>
          <ul>
            <% c.audience.forEach(function (a) { %><li><%= a %></li><% }); %>
          </ul>
        </div>
        <a class="btn btn--navy btn--full" href="/register" style="margin-top:16px">Register — <%= c.fee.toLowerCase() %></a>
      </aside>
    </div>
  </section>

  <!-- ================= SPEAKERS ================= -->
  <section class="section section--paper" id="speakers">
    <div class="wrap">
      <div class="section__head">
        <h2 class="section__title">Speakers</h2>
        <p class="section__lede"><%= c.speakersNote %></p>
      </div>

      <div class="speakers">
        <% c.speakers.forEach(function (s) { %>
          <article class="speaker">
            <div class="speaker__portrait">
              <img src="<%= s.image %>" alt="" loading="lazy" aria-hidden="true">
              <span class="speaker__initials"><%= s.name.split(' ').map(function(w){return w[0];}).join('') %></span>
            </div>
            <h3 class="speaker__name"><%= s.name %></h3>
            <div class="speaker__affil"><%= s.affiliation %></div>
            <% if (s.talk) { %><p class="speaker__talk"><%= s.talk %></p><% } %>
            <% if (s.blurb) { %><p class="speaker__blurb"><%= s.blurb %></p><% } %>
            <% if (s.links && s.links.length) { %>
              <div class="speaker__links">
                <% s.links.forEach(function (l, i) { %><% if (i) { %> · <% } %><a href="<%= l.href %>" rel="noopener noreferrer" target="_blank"><%= l.label %></a><% }); %>
              </div>
            <% } %>
          </article>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- ================= PROGRAM ================= -->
  <section class="section" id="program">
    <div class="wrap split">
      <div>
        <h2 class="section__title">Program</h2>
        <p class="section__lede"><%= c.programNote %></p>

        <div class="program">
          <% c.program.forEach(function (row) { %>
            <% if (row.kind === 'session') { %>
              <div class="program__session">
                <span class="program__session-name"><%= row.title %></span>
                <% if (row.chairs) { %><span class="program__chairs">Chairs: <%= row.chairs %></span><% } %>
              </div>
            <% } else { %>
              <div class="program__row program__row--<%= row.kind %>">
                <div class="program__time"><%= row.time %></div>
                <div>
                  <div class="program__title"><%= row.title %><% if (row.kind === 'keynote') { %><span class="tag tag--keynote">Keynote</span><% } %></div>
                  <% if (row.who) { %>
                    <div class="program__who"><%= row.who %><% if (row.where) { %> · <span class="program__where"><%= row.where %></span><% } %></div>
                  <% } %>
                </div>
              </div>
            <% } %>
          <% }); %>
        </div>
      </div>

      <aside>
        <figure class="figure figure--tall">
          <img src="/img/biofilm.jpg" alt="Fluorescence in situ hybridization of a mixed bacterial community" loading="lazy">
        </figure>
        <div class="card" style="margin-top:16px">
          <div class="card__title">Getting there</div>
          <p style="font-size:.94rem;color:var(--ink-soft)"><%= c.venueNote %></p>
          <p style="font-size:.94rem;margin-top:10px">
            <a href="https://www.google.com/maps/search/?api=1&amp;query=<%= encodeURIComponent(c.mapQuery) %>" target="_blank" rel="noopener noreferrer">Open in Maps →</a>
          </p>
          <p style="font-size:.94rem;color:var(--ink-soft);margin-top:12px"><%= c.accessibilityNote %></p>
        </div>
      </aside>
    </div>
  </section>

  <!-- ================= KEY DATES ================= -->
  <section class="section section--paper" id="dates">
    <div class="wrap two-col two-col--divided">
      <div>
        <h2 class="section__title">Key dates</h2>
        <ul class="dates" style="margin-top:14px">
          <% c.keyDates.forEach(function (d) { %>
            <li class="is-<%= d.state %>">
              <span class="dates__label"><%= d.label %></span>
              <span class="dates__value"><%= d.value %></span>
            </li>
          <% }); %>
        </ul>
      </div>

      <div>
        <h2 class="section__title">Attending</h2>
        <p style="margin-top:12px;color:var(--ink-soft)"><%= c.attendingNote %></p>
        <a class="btn btn--navy" href="/register" style="margin-top:20px">Register</a>
      </div>
    </div>
  </section>

  <!-- ================= COMMITTEE + CONTACT ================= -->
  <section class="section" id="committee">
    <div class="wrap split">
      <div>
        <h2 class="section__title">Organizing committee</h2>
        <div class="people" style="margin-top:18px">
          <% c.committee.forEach(function (p) { %>
            <div class="people__cell">
              <div class="people__name"><%= p.name %></div>
              <div class="people__affil"><%= p.affiliation %></div>
            </div>
          <% }); %>
        </div>
      </div>

      <aside id="contact">
        <h2 class="section__title">Contact</h2>
        <p style="margin-top:14px;color:var(--ink-soft);font-size:.95rem"><%= c.contactNote %></p>
        <p style="margin-top:8px">
          <a href="mailto:<%= c.contactEmail %>"><%= c.contactEmail %></a>
        </p>
      </aside>
    </div>
  </section>

  <!-- ================= CTA ================= -->
  <section class="cta-band">
    <div class="wrap cta-band__inner">
      <div>
        <h2>Registration is open</h2>
        <p>Two steps, free, and you can attach your abstract as you go.</p>
      </div>
      <a class="btn btn--navy" href="/register">Register</a>
    </div>
  </section>

</main>

<%- include('partials/footer') %>
