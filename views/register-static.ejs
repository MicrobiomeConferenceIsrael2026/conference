<%- include('partials/head', { pageTitle: 'Register' }) %>
<%- include('partials/header') %>

<main id="main">
  <section class="page-head">
    <div class="wrap-narrow" style="max-width:820px">
      <h1>Register</h1>
      <p><%= c.fee %> to attend. Registration closes <%= c.registrationDeadline %>.</p>
    </div>
  </section>

  <div class="form-shell" style="max-width:860px">
    <% if (c.googleForm && c.googleForm.embedUrl) { %>
      <div class="form-embed">
        <iframe
          src="<%= c.googleForm.embedUrl %>"
          width="100%"
          height="<%= c.googleForm.embedHeight || 1400 %>"
          frameborder="0" marginheight="0" marginwidth="0"
          title="Registration form"
          loading="lazy">Loading the registration form…</iframe>
      </div>
      <p class="form-embed__fallback">
        Form not loading?
        <a href="<%= c.googleForm.formUrl %>" target="_blank" rel="noopener noreferrer">Open it in a new tab</a>.
      </p>
    <% } else { %>
      <div class="form-card">
        <div class="alert alert--warn" style="margin:0">
          <strong>The registration form is not connected yet.</strong>
          Add your Google Form URLs to <code>lib/content.js</code> and rebuild.
          See <code>DEPLOY.md</code>.
        </div>
      </div>
    <% } %>

    <div class="card" style="margin-top:24px">
      <div class="card__title">The day</div>
      <ul class="dates">
        <li><span class="dates__label">Conference</span><span class="dates__value"><%= c.date %></span></li>
        <li><span class="dates__label">Time</span><span class="dates__value"><%= c.timeRange %></span></li>
        <li><span class="dates__label">Registration closes</span><span class="dates__value"><%= c.registrationDeadline %></span></li>
      </ul>
      <p style="font-size:.92rem;color:var(--muted);margin-top:14px">
        Questions: <a href="mailto:<%= c.contactEmail %>"><%= c.contactEmail %></a>
      </p>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
