<%- include('partials/head', { pageTitle: 'Your details' }) %>
<%- include('partials/header') %>
<% function v(k) { return values && values[k] ? values[k] : ''; } %>
<% function err(k) { return errors && errors[k] ? errors[k] : ''; } %>

<main id="main">
  <section class="page-head">
    <div class="wrap-narrow" style="max-width:760px">
      <div class="eyebrow eyebrow-light">Registration · step 2 of 2</div>
      <h1>Your details</h1>
      
      <div class="steps">
        <div class="steps__item is-done">
          <span class="steps__num">✓</span><span class="steps__label">Abstract</span>
        </div>
        <span class="steps__bar"></span>
        <div class="steps__item is-active">
          <span class="steps__num">2</span><span class="steps__label">Your details</span>
        </div>
        <span class="steps__bar"></span>
        <div class="steps__item">
          <span class="steps__num">3</span><span class="steps__label">Confirmation</span>
        </div>
      </div>
    </div>
  </section>

  <div class="form-shell">
    <div class="form-card">
      <% if (Object.keys(errors || {}).length) { %>
        <div class="alert alert--error">
          Some fields need attention — they are marked below.
        </div>
      <% } %>

      <form method="post" action="/register/details" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrf %>">

        <!-- honeypot: hidden from humans, irresistible to bots -->
        <div class="honey" aria-hidden="true">
          <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off"></label>
        </div>

        <fieldset class="fieldset">
          <legend class="fieldset__legend">Participant</legend>

          <div class="field <%= err('full_name') ? 'has-error' : '' %>">
            <label class="field__label" for="full_name">Full name <span class="req">*</span></label>
            <input type="text" id="full_name" name="full_name" required maxlength="120"
                   autocomplete="name" placeholder="Jane Smith" value="<%= v('full_name') %>">
            <div class="field__hint">As it should appear on your badge.</div>
            <% if (err('full_name')) { %><div class="field__error"><%= err('full_name') %></div><% } %>
          </div>

          <div class="field <%= err('email') ? 'has-error' : '' %>">
            <label class="field__label" for="email">E-mail address <span class="req">*</span></label>
            <input type="email" id="email" name="email" required maxlength="160"
                   autocomplete="email" placeholder="jane.smith@university.ac.il" value="<%= v('email') %>">
            <div class="field__hint">Where your confirmation is sent.</div>
            <% if (err('email')) { %><div class="field__error"><%= err('email') %></div><% } %>
          </div>

          <div class="grid-2">
            <div class="field <%= err('affiliation') ? 'has-error' : '' %>">
              <label class="field__label" for="affiliation">Affiliation <span class="req">*</span></label>
              <input type="text" id="affiliation" name="affiliation" required maxlength="160"
                     autocomplete="organization" placeholder="University or company" value="<%= v('affiliation') %>">
              <% if (err('affiliation')) { %><div class="field__error"><%= err('affiliation') %></div><% } %>
            </div>

            <div class="field <%= err('role') ? 'has-error' : '' %>">
              <label class="field__label" for="role">Role <span class="req">*</span></label>
              <select id="role" name="role" required>
                <option value="">— select —</option>
                <% c.roles.forEach(function (r) { %>
                  <option value="<%= r %>" <%= v('role') === r ? 'selected' : '' %>><%= r %></option>
                <% }); %>
              </select>
              <% if (err('role')) { %><div class="field__error"><%= err('role') %></div><% } %>
            </div>
          </div>

          <div class="field">
            <label class="field__label" for="country">Country <span style="color:var(--muted);font-weight:400">(optional)</span></label>
            <input type="text" id="country" name="country" maxlength="60"
                   autocomplete="country-name" placeholder="Israel" value="<%= v('country') %>">
          </div>
        </fieldset>

        <% if (wantsAbstract) { %>
        <fieldset class="fieldset">
          <legend class="fieldset__legend">Abstract</legend>

          <div class="field">
            <label class="field__label">Preferred format</label>
            <div class="choices">
              <label class="choice" style="padding:15px 18px 15px 50px">
                <input type="radio" name="abstract_type" value="poster"
                       <%= v('abstract_type') !== 'talk' ? 'checked' : '' %>>
                <span class="choice__dot" style="top:17px" aria-hidden="true"></span>
                <span class="choice__title" style="font-size:1rem">Poster</span>
                <span class="choice__desc">Two poster sessions, plus an optional 2-minute pitch.</span>
              </label>
              <label class="choice" style="padding:15px 18px 15px 50px">
                <input type="radio" name="abstract_type" value="talk"
                       <%= v('abstract_type') === 'talk' ? 'checked' : '' %>>
                <span class="choice__dot" style="top:17px" aria-hidden="true"></span>
                <span class="choice__title" style="font-size:1rem">Short talk</span>
                <span class="choice__desc">15 minutes including questions. Slots are limited.</span>
              </label>
            </div>
          </div>

          <div class="field <%= err('abstract_title') ? 'has-error' : '' %>">
            <label class="field__label" for="abstract_title">Abstract title <span class="req">*</span></label>
            <input type="text" id="abstract_title" name="abstract_title" maxlength="250"
                   placeholder="The title of your abstract"
                   value="<%= v('abstract_title') %>">
            <% if (err('abstract_title')) { %><div class="field__error"><%= err('abstract_title') %></div><% } %>
          </div>

          <div class="field <%= err('abstract_authors') ? 'has-error' : '' %>">
            <label class="field__label" for="abstract_authors">Authors <span class="req">*</span></label>
            <input type="text" id="abstract_authors" name="abstract_authors" maxlength="400"
                   placeholder="Presenting author first, comma separated" value="<%= v('abstract_authors') %>">
            <div class="field__hint">No affiliations needed.</div>
            <% if (err('abstract_authors')) { %><div class="field__error"><%= err('abstract_authors') %></div><% } %>
          </div>

          <div class="field <%= err('abstract_body') ? 'has-error' : '' %>">
            <label class="field__label" for="abstract_body">
              Abstract text <span class="req">*</span>
              <span class="counter" id="wordCount" data-max="300">0 / 300 words</span>
            </label>
            <textarea id="abstract_body" name="abstract_body" maxlength="4000"
                      placeholder="Plain text, up to 300 words. No figures or references."><%= v('abstract_body') %></textarea>
            <div class="field__hint">Background, what you did, what you found.</div>
            <% if (err('abstract_body')) { %><div class="field__error"><%= err('abstract_body') %></div><% } %>
          </div>
        </fieldset>
        <% } %>

        <fieldset class="fieldset">
          <legend class="fieldset__legend">Practicalities</legend>

          <div class="field">
            <label class="field__label" for="dietary">Dietary or access needs <span style="color:var(--muted);font-weight:400">(optional)</span></label>
            <input type="text" id="dietary" name="dietary" maxlength="300"
                   placeholder="Vegetarian, step-free access…" value="<%= v('dietary') %>">
          </div>

          <div class="field">
            <label class="field__label" for="notes">Anything else? <span style="color:var(--muted);font-weight:400">(optional)</span></label>
            <textarea id="notes" name="notes" maxlength="600" style="min-height:90px"><%= v('notes') %></textarea>
          </div>

          <div class="field" style="margin-bottom:0">
            <label class="check">
              <input type="checkbox" name="consent_updates" value="1" <%= v('consent_updates') ? 'checked' : '' %>>
              <span>Email me about this meeting and future editions.</span>
            </label>
          </div>
        </fieldset>

                <div class="form-actions">
          <a class="back" href="/register">← Back</a>
          <button class="btn btn--gold" type="submit">
            <% if (wantsAbstract) { %>Complete registration &amp; submit abstract<% } else { %>Complete registration<% } %>
          </button>
        </div>
      </form>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
