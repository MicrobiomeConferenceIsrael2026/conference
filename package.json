{
  "name": "microbiome-conference-2026",
  "version": "1.0.0",
  "private": true,
  "description": "Conference website with registration, abstract submission, encrypted SQLite storage and a secured admin area.",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "share": "node tools/share.js",
    "init-secrets": "node tools/init-secrets.js",
    "keys": "node tools/print-env.js",
    "smoke": "node tools/smoke-test.js",
    "docker:build": "docker build -t microbiome-2026 .",
    "docker:run": "docker compose up -d"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.4.1"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "nodemailer": "^9.0.3"
  }
}
